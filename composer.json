{
    "name": "pieceofcake2/twig-view",
    "description": "Twig for CakePHP 2.x",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "twig", "view"],
    "license": "MIT",
    "require": {
        "php": ">=8.0.2",
        "composer/installers": "*",
        "pieceofcake2/cakephp": "^2.12",
        "twig/twig": "^3.19"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpstan-cakephp2": "^0.2.1"
    },
    "replace": {
        "wyrihaximus/twig-view": "^1.0"
    },
    "autoload-dev": {
        "exclude-from-classmap": [
            "vendor/pieceofcake2/app/src/Console/Command/AppShell.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "TwigView"
    }
}
