{
    "name": "pieceofcake2/twig-view",
    "description": "Twig 3 template engine for CakePHP 2 views",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "twig", "view"],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "composer/installers": "^1.0 || ^2.0",
        "pieceofcake2/cakephp": "^2.12",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpcs-cakephp2": "^1.0",
        "pieceofcake2/phpstan-cakephp2": "^0.2.3"
    },
    "replace": {
        "wyrihaximus/twig-view": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "TwigView\\": "src/"
        },
        "files": [
            "src/legacy.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TwigView\\Test\\TestCase\\": "tests/TestCase/",
            "TestApp\\": "tests/test_app/src/",
            "TestTwigView\\": "tests/test_app/plugins/TestTwigView/src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "TwigView"
    }
}
